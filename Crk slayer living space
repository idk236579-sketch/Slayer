-- ============ TOGGLE PANEL ============
local panelOpen = false
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function togglePanel()
    panelOpen = not panelOpen
    if panelOpen then
        panel.Visible = true; panel.Size = UDim2.new(0, 0, 0, 0); panel.BackgroundTransparency = 1
        TweenService:Create(panel, tweenInfo, {Size = UDim2.new(0, 400, 0, 320), BackgroundTransparency = 0}):Play()
    else
        local t = TweenService:Create(panel, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
        t:Play(); t.Completed:Connect(function() panel.Visible = false end)
    end
end

