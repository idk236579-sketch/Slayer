-- ============ CONFIG ============
local MONSTER_KEYWORDS = {"monster", "zombie", "enemy", "slayer", "mob", "boss", "demon"}
local KILL_RANGE = 100

-- Remote config (server damage endpoint)
local REMOTE_KEY = "EMMFOSS__!ZCNSJNXCSDWQSANBX"
local function getDamageRemote()
    local folder = ReplicatedStorage:FindFirstChild("ALLREMBINDS")
    return folder and folder:FindFirstChild("Pls_Dont_Hack_Plssssssssss")
end

-- Get current tool M1 damage key (matches server tool damage)
local function getM1Key()
    local stats2 = player:FindFirstChild("PlayerStats2")
    local activeTool = stats2 and stats2:FindFirstChild("ActiveTool")
    local name = activeTool and tostring(activeTool.Value) or ""
    if name == "" then return "M1:Combat" end
    return "M1:" .. name
end

-- ============ STATE ============
local playerKillActive = false
local monsterKillActive = false
local noclipActive = false
local noclipConn = nil

-- ============ LOGIC: REAL PLAYER KILL ============
local function startPlayerKill()
    if playerKillActive then return end
    playerKillActive = true

    local damageRemote = getDamageRemote()
    if not damageRemote then
        warn("[KillPlayer] Damage remote not found")
        playerKillActive = false
        return
    end

    task.spawn(function()
        while playerKillActive do
            task.wait(0.05)
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hum or hum.Health <= 0 or not hrp then continue end

            local K = getM1Key()

            for _, otherPlayer in pairs(Players:GetPlayers()) do
                if not playerKillActive then break end
                if otherPlayer ~= player then
                    local oChar = otherPlayer.Character
                    local oHum = oChar and oChar:FindFirstChildOfClass("Humanoid")
                    local oHrp = oChar and oChar:FindFirstChild("HumanoidRootPart")
                    if oChar and oHum and oHum.Health > 0 and oHrp then
                        local dist = (hrp.Position - oHrp.Position).Magnitude
                        if dist < 50 then
                            pcall(function()
                                damageRemote:FireServer(REMOTE_KEY, "Main_Damger_OC_R", {
                                    oChar, { D = math.huge, K = K, N = 4, F = char }
                                })
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function stopPlayerKill()
    playerKillActive = false
end

-- ============ LOGIC: AUTO KILL MONSTERS ============
local function isMonster(model)
    if not model or not model:IsA("Model") then return false end
    local name = model.Name:lower()
    for _, kw in pairs(MONSTER_KEYWORDS) do
        if name:find(kw) then return true end
    end
    return false
end

local function startMonsterKill()
    if monsterKillActive then return end
    monsterKillActive = true

    local damageRemote = getDamageRemote()
    if not damageRemote then
        warn("[KillMonster] Damage remote not found")
        monsterKillActive = false
        return
    end

    task.spawn(function()
        while monsterKillActive do
            task.wait(0.05)
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hum or hum.Health <= 0 or not hrp then continue end

            local K = getM1Key()
            local charsFolder = Workspace:FindFirstChild("Characters")
            if not charsFolder then continue end

            for _, obj in ipairs(charsFolder:GetChildren()) do
                if not monsterKillActive then break end
                if isMonster(obj) then
                    local oHum = obj:FindFirstChildOfClass("Humanoid")
                    local oHrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                    if oHum and oHum.Health > 0 and oHrp then
                        local dist = (hrp.Position - oHrp.Position).Magnitude
                        if dist < KILL_RANGE then
                            pcall(function()
                                damageRemote:FireServer(REMOTE_KEY, "Main_Damger_OC_R", {
                                    obj, { D = math.huge, K = K, N = 4, F = char }
                                })
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function stopMonsterKill()
    monsterKillActive = false
end

-- ============ LOGIC: NOCLIP ============
local function toggleNoclip(state)
    noclipActive = state
    if state then
        if noclipConn then noclipConn:Disconnect() end
        noclipConn = RunService.Stepped:Connect(function()
            local char = player.Character
            if noclipActive and char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
        local char = player.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ============ LOGIC: SPEED & JUMP ============
local function setSpeed(val)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = val end
end

local function setJump(val)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.UseJumpPower = true
        hum.JumpPower = val
    end
end

